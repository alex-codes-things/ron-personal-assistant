# Optional absolute path when adb.exe is not available through PATH.
RON_ADB_PATH=

# Optional Nexus 7 serial. Ron safely remembers it after unambiguous discovery.
RON_TABLET_SERIAL=

# Ron remains fully usable without the tablet face. Zero (the default) shows
# only connection-state changes and never repeats an offline reminder. Set a
# value from 5-240 only if you explicitly want periodic reminders.
RON_FACE_REMINDER_MINUTES=0

# AI provider. Auto prefers a Groq key, then an OpenAI key, then local Ollama.
# Groq's free plan is the recommended low-load setup for this project.
RON_AI_PROVIDER=auto
GROQ_API_KEY=
RON_GROQ_MODEL=openai/gpt-oss-120b
RON_GROQ_REASONING_EFFORT=low
RON_GROQ_TIMEOUT=30
# Keeps normal Ron requests below Groq's free-plan 8K tokens/minute allowance.
RON_GROQ_MAX_PROMPT_CHARACTERS=24000
RON_AI_FALLBACK_LOCAL=true

# Optional paid OpenAI provider retained for compatibility. These can stay blank
# when Groq is selected.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
RON_OPENAI_MODEL=gpt-5.4-mini
RON_OPENAI_REASONING_EFFORT=none
RON_OPENAI_TIMEOUT=30

# Optional local AI/fallback. Ollama remains bound to this computer only and is
# never preloaded while Groq/OpenAI is working.
RON_LOCAL_MODEL=qwen3.5:4b
RON_OLLAMA_URL=http://127.0.0.1:11434

# A short lifetime lets an emergency fallback unload again after the outage.
RON_MODEL_KEEP_ALIVE=2m
RON_MODEL_CONTEXT=8192
RON_AI_TIMEOUT=120
RON_MAX_PROMPT_CHARACTERS=64000

# Terminal chat personality and bounded conversation memory.
RON_USER_NAME=Alex
RON_READY_HISTORY_TURNS=4
RON_CHAT_HISTORY_TURNS=16
RON_CHAT_HISTORY_CHARACTERS=12000
RON_CHAT_MAX_INPUT_CHARACTERS=6000
RON_CHAT_MAX_OUTPUT_TOKENS=512
# Voice replies are deliberately shorter so Ron reaches the first spoken sentence quickly.
RON_CHAT_VOICE_MAX_OUTPUT_TOKENS=192
RON_CHAT_TEMPERATURE=0.7

# Keep normal terminal output conversational. Use INFO or DEBUG temporarily
# when diagnosing Ron's internals.
RON_LOG_LEVEL=WARNING

# Microphone input and the Hey Ron/silence detectors stay local. With the Groq
# provider, only a finalized post-wake command is uploaded for transcription.
# Auto uses Groq when GROQ_API_KEY above is filled, otherwise local Whisper.
RON_VOICE_ENABLED=true
RON_ASR_PROVIDER=auto
RON_ASR_FALLBACK_LOCAL=true
RON_GROQ_ASR_MODEL=whisper-large-v3-turbo
RON_GROQ_ASR_RETRY_MODEL=whisper-large-v3
RON_GROQ_ASR_TIMEOUT=15
RON_MICROPHONE=
RON_AUDIO_BLOCK_MS=32
RON_WAKE_PHRASE=Hey Ron
RON_WAKE_ALIASES=hey ron|hey run|hey wrong|hey ryan
RON_WAKE_FUZZY_THRESHOLD=0.84
# Personal ASR renderings accepted only after the acoustic Hey Ron detector fires.
# These came from Alex's calibration and are NOT standalone wake words.
RON_WAKE_KWS_ALIASES=peron|here on|tehran|aaron|heyron
# high = accent-friendly low-latency KWS; balanced preserves the raw threshold/score below.
RON_WAKE_SENSITIVITY=high
RON_WAKE_THRESHOLD=0.35
RON_WAKE_SCORE=1.5
RON_WAKE_COOLDOWN=2.0
RON_WAKE_VERIFY_TRANSCRIPT=true

# Complete-utterance endpointing. These avoid chopped words without adding a
# long fixed delay after every sentence.
RON_VAD_THRESHOLD=0.5
# v0.9 responsive endpoint. The old RON_VOICE_END_SILENCE name is no longer used.
RON_VOICE_RESPONSIVE_END_SILENCE=0.38
RON_VOICE_MIN_SPEECH=0.20
RON_VOICE_MAX_SPEECH=15.0
RON_VOICE_COMMAND_WAIT=2.5
RON_WAKE_ACK_ENABLED=true
RON_WAKE_ACK_PHRASES=Yes?|I'm listening.|Go ahead.
RON_WAKE_FOLLOWUP_WAIT=8.0
# Short guard after the tiny wake acknowledgement only; normal replies still use RON_TTS_ECHO_GUARD.
RON_WAKE_ACK_ECHO_GUARD=0.06
RON_WAKE_FAST_HANDOFF=true
# Short KWS-confirmed utterances under this duration can say "Yes?" without full Whisper verification.
RON_WAKE_FAST_SEGMENT_SECONDS=0.90
# A wake-only handoff must also end soon after KWS fired; this prevents a short
# "Hey Ron, status" command from being swallowed as if it only said "Hey Ron".
RON_WAKE_FAST_POST_SECONDS=0.68
# Voice interaction contract: strict, followup, or continuous. Strict requires
# "Hey Ron" before every completed command and is the recommended default.
RON_INTERACTION_MODE=strict
# Legacy compatibility switch. New setups should choose the mode above directly.
RON_VOICE_AUTO_FOLLOWUP=false
RON_VOICE_AUTO_FOLLOWUP_WAIT=6.0
# During a reply, interruption remains locked behind a fresh "Hey Ron" wake.
RON_VOICE_BARGE_IN=true
# A fresh wake-gated command replaces generated speech, or waits for a running
# computer action to reach its safe completion boundary before it starts.
RON_VOICE_ACCEPT_NEW_TURN=true
RON_VOICE_INTERRUPT_PHRASES=stop|wait|hold on|quiet|cancel that|never mind|that's enough
# A cached Jarvis-style cue fills only genuinely slow AI waits.
RON_VOICE_THINKING_CUE=true
RON_VOICE_THINKING_CUE_DELAY=0.9
RON_VOICE_THINKING_CUES=On it.|I'm checking that now.
# Speak one cached, concrete status cue when an approved action begins.
RON_VOICE_ACTION_CUES=true
RON_VOICE_CHAT_TIMEOUT=25.0
RON_VOICE_MIN_CONFIDENCE=0.18

# Cold local ASR fallback. It is not loaded while Groq works. If Groq is offline,
# most speech uses beam 1 and uncertain speech alone is retried at beam 5.
# The legacy RON_WHISPER_BEAM_SIZE is accepted as the retry beam.
RON_WHISPER_MODEL=distil-large-v3
RON_WHISPER_COMPUTE_TYPE=int8
RON_WHISPER_THREADS=4
RON_WHISPER_FAST_BEAM_SIZE=1
RON_WHISPER_RETRY_ENABLED=true
RON_WHISPER_RETRY_BEAM_SIZE=5
RON_WHISPER_RETRY_CONFIDENCE=0.52
RON_WHISPER_PATIENCE=1.0
RON_WHISPER_INITIAL_PROMPT=Hey Ron. Open Spotify. Open Notepad. Open Calculator. Open File Explorer. Open Visual Studio Code. Set volume to twenty percent. Set brightness to fifty percent. Play Galway Girl on Spotify. What time is it?
RON_WHISPER_PRELOAD=true
RON_WHISPER_DOWNLOAD_ROOT=
RON_KWS_MODEL_DIR=
RON_VAD_MODEL=

# Keep this list short to avoid recognition over-bias. Corrections remain
# deterministic and tool arguments are validated after transcription.
RON_VOICE_HOTWORDS=Ron,Spotify,Notepad,Calculator,File Explorer,Visual Studio Code,VS Code,Brave,YouTube,Galway Girl,volume,brightness,Nexus 7
RON_VOICE_REMINDER_MINUTES=20

# Optional Spotify Web API integration. The setup helper saves the non-secret
# client ID locally, so these are normally left blank.
RON_SPOTIFY_CLIENT_ID=
RON_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Ron Network. This is optional: AI, voice and Windows tools keep working
# even when the router, Wi-Fi, tablet or discovery service is unavailable.
RON_NETWORK_ENABLED=true
RON_NETWORK_DISCOVERY=true
RON_NETWORK_DISCOVERY_PORT=8766
RON_NETWORK_DISCOVERY_INTERVAL=10
RON_NETWORK_DEGRADED_AFTER=8
RON_NETWORK_DEVICE_TIMEOUT=20

# Optional manual tablet LAN address if UDP discovery is blocked by the router.
# Leave blank to use discovery, with the existing USB/ADB path as a fallback.
RON_FACE_HOST=
RON_FACE_PORT=8765

# Ron long-term memory. The external drive is optional at runtime: when it is
# missing Ron stays usable and queues long-term writes on the laptop.
RON_STORAGE_PATH=
RON_STORAGE_QUEUE_LIMIT_MB=512
RON_STORAGE_MIN_FREE_GB=5
RON_LOCAL_MIN_FREE_MB=1024
RON_STORAGE_CHECK_SECONDS=10

# Memory intelligence. Conservative mode learns only a small set of stable user facts
# (for example equipment, preferences and active projects). It never auto-saves Ron's
# own replies, credential-like secrets, or obviously temporary statements. Use off to
# require explicit "remember that ..." commands for every durable memory.
RON_MEMORY_AUTO_LEARN=conservative

# Future screenshot-assisted memory is request-only by default. Allowed values:
# off, on_request, session. This does not enable continuous background capture.
RON_VISUAL_MEMORY_MODE=on_request

# Cloud-first neural speech. Auto uses Groq Orpheus when GROQ_API_KEY is present;
# otherwise it uses local Kokoro. Groq's 200-character request limit is handled
# as up to four sentence-safe parts, with the full answer also kept in the terminal.
# Accept the Orpheus model terms once in Groq before the first use; see
# docs/CLOUD_VOICE.md, then run: python .\scripts\check_groq_voice.py --play
RON_TTS_ENABLED=true
RON_TTS_PROVIDER=auto
RON_TTS_FALLBACK_LOCAL=true
RON_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
RON_GROQ_TTS_VOICE=daniel
RON_GROQ_TTS_TIMEOUT=15
RON_GROQ_TTS_MAX_REQUESTS_PER_TURN=4
# Start playback from Groq's first complete PCM packet instead of waiting for the full WAV.
RON_GROQ_TTS_STREAMING=true
# Use quick Windows system speech before ever loading cold Kokoro after a cloud failure.
RON_TTS_FAST_FALLBACK=true
# Local Kokoro fallback settings. The large model remains cold while Groq works.
RON_TTS_VOICE=bm_george
RON_TTS_SPEED=0.94
RON_TTS_LANGUAGE=en-gb
RON_TTS_GAIN=1.0
RON_TTS_MAX_CHARACTERS=700
RON_TTS_LEVEL_MS=40
# Groq and local speech both split on comfortable sentence/word boundaries.
RON_TTS_CHUNK_CHARACTERS=180
RON_TTS_PREFETCH_CHUNKS=true
# Start speaking complete sentences while the cloud or local model is generating.
RON_TTS_STREAMING=true
RON_TTS_CONCURRENT_SYNTHESIS=true
# Keep Kokoro responsive without starving the local chat model on CPU.
RON_TTS_CPU_THREADS=2
# Detector reset is event-driven; only a short speaker-tail guard remains.
RON_TTS_ECHO_GUARD=0.12
RON_TTS_OUTPUT_DEVICE=
RON_TTS_MODEL=
RON_TTS_VOICES=
